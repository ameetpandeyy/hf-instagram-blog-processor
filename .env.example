# ==========================================
# TeAmo Backend Environment Configuration
# ==========================================

# Google Gemini API Key (Gemini 2.0 Flash)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Credentials (PostgreSQL DB + Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Firebase Admin Credentials (For Auth Token Verification & Zero Data Loss Sync)
FIREBASE_PROJECT_ID=teamo-ea8f2
FIREBASE_CREDENTIALS_PATH=./firebase_service_account.json

# Server Config
HOST=0.0.0.0
PORT=7860
DEBUG=False
ENVIRONMENT=production
